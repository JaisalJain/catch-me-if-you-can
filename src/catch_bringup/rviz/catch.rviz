Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (floor)
      Enabled: false
      Value: false
      Reference Frame: world
      Plane Cell Count: 30
      Cell Size: 0.1
      Color: 90; 90; 90
      Alpha: 0.4
    # both arms, grippers, B's wrist camera, table, pedestals and pallets (all URDF links; robot_state_publisher)
    - Class: rviz_default_plugins/RobotModel
      Name: Robots + scene
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    # cubes from the simulator's ground truth: display only (catch_sim rviz_display; no robot decision uses it)
    - Class: rviz_default_plugins/MarkerArray
      Name: Cubes (ground truth, display only)
      Enabled: true
      Value: true
      Topic:
        Value: /display/ground_truth_cubes
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF (frames)
      Enabled: false
      Value: false
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.15
      Frames:
        All Enabled: false
        a_tcp: {Value: true}
        b_tcp: {Value: true}
        b_wrist_cam_optical: {Value: true}
    - Class: rviz_default_plugins/Image
      Name: B wrist camera
      Enabled: true
      Value: true
      Topic:
        Value: /cameras/b_wrist/image_raw
        Depth: 1
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: world
    Background Color: 38; 41; 46
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.05
      Focal Point: {X: 0.0, Y: -0.05, Z: 1.0}
      Pitch: 0.38
      Yaw: 4.6
Window Geometry:
  Width: 1600
  Height: 900
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  B wrist camera:
    collapsed: false
